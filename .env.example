# Backend
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:5173

# Local infrastructure (used by Docker Compose)
POSTGRES_DB=enterprise_agent_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-for-local-development
REDIS_PASSWORD=change-me-for-local-development
SEARXNG_SECRET=replace-with-a-long-random-local-secret

