# Backend
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:5173

# Local infrastructure (used by Docker Compose)
POSTGRES_DB=enterprise_agent_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-for-local-development
REDIS_PASSWORD=change-me-for-local-development
SEARXNG_SECRET=replace-with-a-long-random-local-secret
# Required once to create the first local administrator. Generate with a password manager.
AUTH_BOOTSTRAP_SECRET=replace-with-a-random-32-character-or-longer-secret

# Optional enterprise OIDC boundary. Configure all four values together when a
# future server-side OIDC adapter is enabled. Never commit a real client secret.
# OIDC_PROVIDER_NAME=Microsoft Entra ID
# OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://platform.example.com/v1/auth/enterprise/callback

# Reserved for the future governed GitHub connector. Do not commit a real token.
# GITHUB_CONNECTOR_TOKEN=

# External providers remain optional until their adapters are enabled.
# FIRECRAWL_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_API_KEY=
